{
  "entities": {
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Tracks a student's 10-stage progress, 3D explorations, strategy choices, quiz score, and reflection.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the student."
        },
        "displayName": {
          "type": "string",
          "description": "Student display name."
        },
        "highestUnlockedStage": {
          "type": "integer",
          "description": "Highest unlocked learning stage from 1 to 10."
        },
        "completedStages": {
          "type": "array",
          "description": "List of completed stage numbers (1..10)."
        },
        "exploredObjects": {
          "type": "array",
          "description": "Identifiers of 3D virtual classroom objects explored."
        },
        "selectedStrategies": {
          "type": "array",
          "description": "List of PAI learning strategies selected successfully."
        },
        "studentAnalysisDone": {
          "type": "boolean",
          "description": "Whether Interaction 1 (student characteristic analysis) is completed."
        },
        "localWisdomDone": {
          "type": "boolean",
          "description": "Whether Interaction 2 (local wisdom integration) is completed."
        },
        "strategyChoiceDone": {
          "type": "boolean",
          "description": "Whether Interaction 3 (strategy selection) is completed."
        },
        "caseAnalysisSummary": {
          "type": "string",
          "description": "Summary of student case analysis."
        },
        "quizScore": {
          "type": "integer",
          "description": "Final evaluation quiz score (0..100)."
        },
        "quizCompleted": {
          "type": "boolean",
          "description": "Whether final evaluation quiz is completed."
        },
        "reflectionText": {
          "type": "string",
          "description": "Student learning reflection text."
        },
        "competencyRecommendation": {
          "type": "string",
          "description": "Recommended competency focus based on quiz and reflection."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation (FieldValue.serverTimestamp())."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update (FieldValue.serverTimestamp())."
        }
      },
      "required": [
        "userId",
        "displayName",
        "highestUnlockedStage",
        "completedStages",
        "exploredObjects",
        "selectedStrategies",
        "studentAnalysisDone",
        "localWisdomDone",
        "strategyChoiceDone",
        "caseAnalysisSummary",
        "quizScore",
        "quizCompleted",
        "reflectionText",
        "competencyRecommendation",
        "createdAt",
        "updatedAt"
      ]
    },
    "AiLabRecord": {
      "title": "AiLabRecord",
      "description": "Stores generated case studies, adaptive quizzes, strategy analyses, and AI tutor sessions.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID."
        },
        "toolType": {
          "type": "string",
          "enum": ["CASE_STUDY", "QUIZ", "STRATEGY_ANALYSIS", "AI_TUTOR"],
          "description": "Generative AI Lab tool type."
        },
        "promptText": {
          "type": "string",
          "description": "Prompt or topic input."
        },
        "responseText": {
          "type": "string",
          "description": "Generated academic PAI content."
        },
        "sourceMode": {
          "type": "string",
          "enum": ["GEMINI_AI", "LOCAL_SIMULATION"],
          "description": "Whether generated by Gemini AI Logic or local simulation fallback."
        },
        "difficultyLevel": {
          "type": "string",
          "enum": ["DASAR", "MENENGAH", "LANJUT"],
          "description": "Adaptive difficulty level."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update."
        }
      },
      "required": [
        "userId",
        "toolType",
        "promptText",
        "responseText",
        "sourceMode",
        "difficultyLevel",
        "createdAt",
        "updatedAt"
      ]
    },
    "ProgressNotification": {
      "title": "ProgressNotification",
      "description": "Real-time student progress update notifications synced across sessions.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID."
        },
        "title": {
          "type": "string",
          "description": "Short notification title."
        },
        "message": {
          "type": "string",
          "description": "Progress update message in Indonesian."
        },
        "stageNumber": {
          "type": "integer",
          "description": "Associated learning stage (1..10)."
        },
        "readFlag": {
          "type": "boolean",
          "description": "Whether notification has been read."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update."
        }
      },
      "required": [
        "userId",
        "title",
        "message",
        "stageNumber",
        "readFlag",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/StudentProgress" },
      "description": "Per-user learning progress, strategy choices, evaluation scores, and reflection."
    },
    "/users/{userId}/ai_records/{recordId}": {
      "schema": { "$ref": "#/entities/AiLabRecord" },
      "description": "Per-user Generative AI Lab history and generated case/quiz/tutor artifacts."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/ProgressNotification" },
      "description": "Per-user real-time progress notification feed."
    }
  }
}
